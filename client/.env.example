# Copy to .env and fill in. .env is git-ignored; this file is committed.
#
# Every VITE_ value is compiled into the built JavaScript and is PUBLIC.
# Never put a secret key, a password or a connection string in here. The one
# key below is Supabase's publishable key, which is public by design.

# Demo mode is the DEFAULT. Only the exact value "false" turns it off, so an
# unset or mistyped variable leaves you on the simulated backend with a visible
# notice, rather than on a silently broken build.
#   unset or true  = simulated backend, no server needed
#   false          = call the real API at VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Where your Express API lives. Ignored while VITE_USE_MOCK_API is true.
# Local: http://localhost:3000     Deployed: https://your-api.onrender.com
# No trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# Sign-in with Google, through Supabase Auth. Only used when
# VITE_USE_MOCK_API=false. Supabase: Dashboard > Project Settings > API Keys.
# Use the PUBLISHABLE key (sb_publishable_...), never the secret one
# (sb_secret_...). It is safe in the website because Row Level Security stops
# it reaching any table.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google's own "Sign in with Google" button (src/components/GoogleButton.jsx),
# so Google's sign-in screen names this site instead of Supabase's address.
# The OAuth client ID from Google Cloud > APIs & Services > Credentials
# ("JobStash web"); the same one saved in Supabase's Google provider. Public,
# not a secret. Leave it out and the site uses the older redirect button.
# Its Authorised JavaScript origins must list every address the site runs on
# (http://localhost, http://localhost:5173 and the live address).
VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# The email address the Privacy page gives for questions and for deleting an
# account. Kept out of the code so no personal address is in the public
# repository. Leave it out and the page points to the GitHub project instead.
VITE_CONTACT_EMAIL=you@example.com
