{
  "name": "final-project-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node start.js",
    "dev": "node --env-file=.env --watch start.js",
    "db:migrate": "node --env-file=.env db/migrate.js",
    "db:seed": "node --env-file=.env db/run.js db/seed.sql",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:backup": "node --env-file=.env db/backup.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
