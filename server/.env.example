# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# PostgreSQL connection string. It contains a password, so it never goes in a
# commit, a screenshot or a VITE_ variable.
#
# Local:    postgresql://postgres:devpassword@localhost:5432/jobstash
# Supabase: Dashboard > Connect > Connection string > URI, then replace
#           [YOUR-PASSWORD]. Use the SESSION POOLER string (port 5432), not the
#           direct one, unless your network has IPv6.
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/jobstash

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
# Add the deployed client's origin here once it exists.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.
